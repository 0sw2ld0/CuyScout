{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CuyScout configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bindAddress": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "enum": ["local", "ci", "device-farm"] },
        "token": { "type": "string" },
        "tokenScopes": { "type": "string" },
        "logFormat": { "type": "string", "enum": ["json"] }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string" },
        "retention": { "type": "integer", "minimum": 0 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autosaveInterval": { "type": "integer", "minimum": 0 },
        "eventRetention": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "redactSensitive": { "type": "boolean" }
      }
    }
  }
}
