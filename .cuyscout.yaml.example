server:
  port: 4723
  bindAddress: "127.0.0.1"
  profile: "local"
  # token: "cambia-este-token"
  tokenScopes: "read,execute,admin"
  logFormat: "json"
artifacts:
  directory: "/tmp/cuyscout-artifacts"
  retention: 0
session:
  autosaveInterval: 10
  eventRetention: 500
  redactSensitive: true
decision:
  # Laya: decisión rápida sin tokens (opcional, desactivado por defecto).
  # Instálalo con Scripts/laya/install_laya.sh; también se activa en caliente con POST /decision/laya.
  layaEnabled: false
  # layaURL: "http://127.0.0.1:8791"
